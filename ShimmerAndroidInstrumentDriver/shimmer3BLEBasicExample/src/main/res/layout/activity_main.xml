<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cs_panel_bg"
        android:orientation="vertical"
        android:padding="@dimen/cs_space_4">

        <Button
            android:id="@+id/connect_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="connectDevice"
            style="@style/Widget.Consensys.Button.Accent"
            android:text="Connect" />

        <Button
            android:id="@+id/startstreaming_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cs_space_2"
            android:onClick="startStreaming"
            android:text="Start Streaming" />

        <Button
            android:id="@+id/stopstreaming_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cs_space_2"
            android:onClick="stopStreaming"
            android:text="Stop Streaming" />

        <Button
            android:id="@+id/disconnect_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cs_space_2"
            android:onClick="disconnectDevice"
            android:text="Disconnect" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>