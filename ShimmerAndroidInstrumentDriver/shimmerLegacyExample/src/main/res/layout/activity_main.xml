<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <android.widget.LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/cs_surface"
        android:padding="@dimen/cs_space_4"
        tools:context="com.shimmerresearch.shimmerlegacyexample.MainActivity">

        <!-- CONNECTION -->
        <TextView
            style="@style/Widget.Consensys.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONNECTION" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cs_space_2"
            android:layout_marginBottom="@dimen/cs_space_4"
            android:orientation="vertical"
            android:background="@drawable/cs_panel_bg"
            android:padding="@dimen/cs_space_4">

            <Button
                android:id="@+id/button"
                style="@style/Widget.Consensys.Button.Accent"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Connect"
                android:onClick="selectDevice"/>

            <Button
                android:id="@+id/button4"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cs_space_2"
                android:text="Disconnect"
                android:onClick="disconnectDevice"/>
        </LinearLayout>

        <!-- STREAMING -->
        <TextView
            style="@style/Widget.Consensys.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAMING" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cs_space_2"
            android:orientation="vertical"
            android:background="@drawable/cs_panel_bg"
            android:padding="@dimen/cs_space_4">

            <Button
                android:id="@+id/button2"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="Start Streaming"
                android:onClick="startStreaming"/>

            <Button
                android:id="@+id/button3"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cs_space_2"
                android:text="Stop Streaming"
                android:onClick="stopStreaming"/>
        </LinearLayout>
<!--
    <Button
        android:id="@+id/button4"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Enable Sensors"
        android:onClick="enableSensors"/>

    <Button
        android:id="@+id/button5"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Configure Sensors"
        android:onClick="configureSensors"/>
-->

    </android.widget.LinearLayout>
</ScrollView>
