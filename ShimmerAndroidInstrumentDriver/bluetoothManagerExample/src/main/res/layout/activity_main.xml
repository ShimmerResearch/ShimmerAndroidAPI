<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <android.widget.LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context="com.shimmerresearch.bluetoothmanagerexample.MainActivity"
        android:orientation="vertical"
        android:background="@color/cs_surface"
        android:padding="@dimen/cs_space_4">

        <!-- CONNECTION -->
        <TextView
            style="@style/Widget.Consensys.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONNECTION" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cs_space_2"
            android:layout_marginBottom="@dimen/cs_space_4"
            android:orientation="vertical"
            android:background="@drawable/cs_panel_bg"
            android:padding="@dimen/cs_space_4">

            <Button
                android:id="@+id/button5"
                style="@style/Widget.Consensys.Button.Accent"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:onClick="connectDevice"
                android:text="Connect" />

            <Button
                android:id="@+id/button8"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cs_space_2"
                android:onClick="disconnectDevice"
                android:text="Disconnect" />
        </LinearLayout>

        <!-- SENSORS -->
        <TextView
            style="@style/Widget.Consensys.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SENSORS" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cs_space_2"
            android:layout_marginBottom="@dimen/cs_space_4"
            android:orientation="vertical"
            android:background="@drawable/cs_panel_bg"
            android:padding="@dimen/cs_space_4">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/cs_text"
                android:text="Enable/Disable Sensors" />

            <Button
                android:id="@+id/button"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cs_space_2"
                android:text="Enable/Disable Sensors"
                android:onClick="openMenu" />

            <Button
                android:id="@+id/button4"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cs_space_2"
                android:text="Configuration"
                android:onClick="openConfigMenu" />

            <TextView
                android:id="@+id/textViewPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cs_space_2"
                android:text=" " />
        </LinearLayout>

        <!-- STREAMING -->
        <TextView
            style="@style/Widget.Consensys.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAMING" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cs_space_2"
            android:layout_marginBottom="@dimen/cs_space_4"
            android:orientation="vertical"
            android:background="@drawable/cs_panel_bg"
            android:padding="@dimen/cs_space_4">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/cs_text"
                android:text="Please refer to the Android Logcat for signal data" />

            <Button
                android:id="@+id/button2"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cs_space_2"
                android:text="Start Streaming"
                android:onClick="startStreaming" />

            <Button
                android:id="@+id/button3"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cs_space_2"
                android:text="Stop Streaming"
                android:onClick="stopStreaming" />
        </LinearLayout>

        <!-- SD LOGGING -->
        <TextView
            style="@style/Widget.Consensys.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SD LOGGING" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cs_space_2"
            android:orientation="vertical"
            android:background="@drawable/cs_panel_bg"
            android:padding="@dimen/cs_space_4">

            <Button
                android:id="@+id/button6"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:onClick="startSDLogging"
                android:text="Start SD Logging" />

            <Button
                android:id="@+id/button7"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cs_space_2"
                android:onClick="stopSDLogging"
                android:text="Stop SD Logging" />
        </LinearLayout>

    </android.widget.LinearLayout>
</ScrollView>
