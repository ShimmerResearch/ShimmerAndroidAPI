<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Consensys design system (light-only). -->
    <style name="Theme.ShimmerAndroidInstrumentDriver" parent="Theme.Consensys">
    </style>

    <style name="Theme.ShimmerAndroidInstrumentDriver.NoActionBar" parent="Theme.Consensys.NoActionBar">
    </style>

    <!-- Light overlay: Consensys toolbar is white with dark grey text, so the
         Dark ActionBar overlay (white-on-white) would be unreadable here. -->
    <style name="Theme.ShimmerAndroidInstrumentDriver.AppBarOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Theme.ShimmerAndroidInstrumentDriver.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>