<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Consensys.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Overflow menu: white surface with dark text -->
        <item name="actionOverflowMenuStyle">@style/Widget.AppCompat.PopupMenu.Overflow</item>
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Light</item>
        <item name="actionBarInsetTop">0dp</item>
    </style>

    <!-- Consensys tab label: 13sp bold UPPERCASE -->
    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/cs_text_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">true</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:fontFamily">@font/carlito</item>
        <item name="fontFamily">@font/carlito</item>
    </style>

</resources>
